@page "/login"

<div class="row justify-content-center mt-5">
    <div class="col-md-4 card shadow-sm p-4">
        <h3 class="text-center mb-4">Connexion</h3>
        
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger text-center">@Error</div>
        }

        <form method="post" action="/api/auth/login" data-enhance="false">
            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="email user " required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mot de passe</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Se connecter</button>
        </form>
    </div>
</div>

@code {
    // Captures the query string error if credentials fail
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}