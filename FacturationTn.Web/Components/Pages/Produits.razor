@page "/produits"
@attribute [Authorize(Roles = "Admin")]

@using FacturationTn.Domain.Entities
@using FacturationTn.Infrastructure.Persistence

@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Gestion des Produits</PageTitle>

<div class="mb-4">
    <h1>Nos Produits</h1>
</div>

<div class="card p-4 mb-5 shadow-sm border-0 bg-light">
    <h5 class="mb-4 text-primary">@(isEditing ? "Modifier le Produit" : "Ajouter un Nouveau Produit")</h5>
    
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label fw-bold">Désignation (ex: Clavier) *</label>
            <input type="text" class="form-control" @bind="currentProduit.Designation" placeholder="Nom du produit" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Prix U. HT (TND)</label>
            <input type="number" step="0.001" class="form-control" @bind="currentProduit.PrixUnitaireHT" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">TVA (%)</label>
            <select class="form-select" @bind="currentProduit.TauxTVA">
                <option value="19">19 %</option>
                <option value="13">13 %</option>
                <option value="7">7 %</option>
                <option value="0">0 % (Exonéré)</option>
            </select>
        </div>
    </div>
    
    <div class="mt-4 d-flex justify-content-end gap-2">
        @if (isEditing)
        {
            <button class="btn btn-secondary" @onclick="AnnulerEdition">Annuler</button>
        }
        <button class="btn btn-success d-flex align-items-center gap-2" @onclick="SauvegarderProduit" disabled="@string.IsNullOrWhiteSpace(currentProduit.Designation)">
            <i class="bi bi-save"></i> @(isEditing ? "Mettre à jour" : "Ajouter")
        </button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Désignation</th>
                <th>Prix HT</th>
                <th>TVA</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!produits.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">Aucun produit enregistré.</td></tr>
            }
            @foreach (var p in produits)
            {
                <tr>
                    <td class="fw-bold">@p.Designation</td>
                    <td>@p.PrixUnitaireHT.ToString("F3") TND</td>
                    <td>@p.TauxTVA %</td>
                    <td>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" title="Modifier" @onclick="() => EditerProduit(p)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer" @onclick="() => SupprimerProduit(p)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Produit> produits = new();
    private Produit currentProduit = new() { TauxTVA = 19 }; // Default TVA for Tunisia is usually 19%
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await ChargerProduits();
    }

    private async Task ChargerProduits()
    {
        produits = await DbContext.Produits.ToListAsync();
    }

    private void EditerProduit(Produit produit)
    {
        // Copy the properties so we don't accidentally edit the table row directly before saving
        currentProduit = new Produit
        {
            Id = produit.Id,
            Designation = produit.Designation,
            PrixUnitaireHT = produit.PrixUnitaireHT,
            TauxTVA = produit.TauxTVA
        };
        isEditing = true;
    }

    private void AnnulerEdition()
    {
        currentProduit = new() { TauxTVA = 19 };
        isEditing = false;
    }

    private async Task SauvegarderProduit()
    {
        if (isEditing)
        {
            var produitToUpdate = await DbContext.Produits.FindAsync(currentProduit.Id);
            if (produitToUpdate != null)
            {
                produitToUpdate.Designation = currentProduit.Designation;
                produitToUpdate.PrixUnitaireHT = currentProduit.PrixUnitaireHT;
                produitToUpdate.TauxTVA = currentProduit.TauxTVA;
                
                DbContext.Produits.Update(produitToUpdate);
            }
        }
        else
        {
            DbContext.Produits.Add(currentProduit);
        }

        await DbContext.SaveChangesAsync();
        AnnulerEdition(); 
        await ChargerProduits(); 
    }

    private async Task SupprimerProduit(Produit produit)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le produit '{produit.Designation}' ?");
        if (confirmed)
        {
            DbContext.Produits.Remove(produit);
            await DbContext.SaveChangesAsync();
            await ChargerProduits();
        }
    }
}